---
import Base from '../layouts/Base.astro';
import data from '../data/douban.json';
import { SITE_TITLE, url } from '../consts';

type Item = {
	type: 'book' | 'movie' | 'music';
	status: 'wish' | 'doing' | 'done';
	title: string;
	url: string;
	/** 本站内的封面路径（public/ 下），没有时显示题字封面 */
	cover?: string;
	rating?: number; // 1-5
	comment?: string;
	date: string;
};

const items = (data.items as Item[]).slice().sort((a, b) => b.date.localeCompare(a.date));

const typeLabel = { book: '书', movie: '影', music: '音' } as const;
const statusLabel = {
	book: { wish: '想读', doing: '在读', done: '读过' },
	movie: { wish: '想看', doing: '在看', done: '看过' },
	music: { wish: '想听', doing: '在听', done: '听过' },
} as const;
// 五档评分对应豆瓣的五个词
const verdict = ['', '很差', '较差', '还行', '推荐', '力荐'];

const count = (t: string) => items.filter((i) => i.type === t).length;
const updated = data.updated ? new Date(data.updated) : null;

// ---------- 统计 ----------
const done = items.filter((i) => i.status === 'done');
const rated = done.filter((i) => i.rating);
const dist = [5, 4, 3, 2, 1].map((n) => ({ n, c: rated.filter((i) => i.rating === n).length }));
const distMax = Math.max(1, ...dist.map((d) => d.c));
const thisYear = new Date().getFullYear();
const doneThisYear = done.filter((i) => new Date(i.date).getFullYear() === thisYear).length;

// ---------- 标记日历：最近 53 周，一格一天，越深表示当天标记越多 ----------
// 日期一律按北京时间归日；「今天」取构建当天（站点每天自动重新构建）。
const dayKey = (d: Date) => d.toLocaleDateString('sv-SE', { timeZone: 'Asia/Shanghai' }); // YYYY-MM-DD
const perDay = new Map<string, string[]>();
for (const i of items) {
	const k = dayKey(new Date(i.date));
	perDay.set(k, [...(perDay.get(k) ?? []), i.title]);
}
const WEEKS = 53;
const today = new Date(`${dayKey(new Date())}T00:00:00Z`);
const start = new Date(today);
start.setUTCDate(today.getUTCDate() - ((today.getUTCDay() + 6) % 7) - (WEEKS - 1) * 7); // 53 周前的周一
const level = (n: number) => (n === 0 ? 0 : n === 1 ? 1 : n === 2 ? 2 : n <= 4 ? 3 : 4);
const weeks = Array.from({ length: WEEKS }, (_, w) => {
	const days = Array.from({ length: 7 }, (_, d) => {
		const dt = new Date(start);
		dt.setUTCDate(start.getUTCDate() + w * 7 + d);
		const key = dt.toISOString().slice(0, 10);
		const titles = perDay.get(key) ?? [];
		return { key, n: titles.length, lv: level(titles.length), future: dt > today, titles, month: dt.getUTCMonth() };
	});
	return { days, month: days[0].month };
});
// 月份标签：只在月份变化的那一周上方显示
const monthLabel = (w: number) => (w === 0 || weeks[w].month !== weeks[w - 1].month ? `${weeks[w].month + 1}月` : '');
const activeDays = [...perDay.keys()].filter((k) => k >= weeks[0].days[0].key).length;
---

<Base title={`书影音 · ${SITE_TITLE}`} description="我在豆瓣上标记的书、电影和音乐，每天自动同步。">
	<main class="container">
		<header class="page-head">
			<span class="label reveal">Inventory　·　物品栏</span>
			<h1 class="reveal" style="--d:.08s">读过的，看过的，听过的</h1>
			<p class="lede reveal" style="--d:.16s">
				数据来自豆瓣，每天自动同步。
				{updated && <span>最近一次：{updated.toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai' })}。</span>}
			</p>
		</header>

		{
			items.length > 0 && (
				<section class="stats panel reveal" aria-label="统计">
					<dl class="nums">
						<div>
							<dt class="label">Total　共计</dt>
							<dd>{items.length}</dd>
						</div>
						<div>
							<dt class="label">Done　已完成</dt>
							<dd>{done.length}</dd>
						</div>
						<div>
							<dt class="label">{thisYear}　今年</dt>
							<dd>{doneThisYear}</dd>
						</div>
					</dl>
					<ul class="dist" aria-label="评分分布">
						{dist.map((d) => (
							<li>
								<span class="label">{verdict[d.n]}</span>
								<span class="bar">
									<i style={`width:${(d.c / distMax) * 100}%`} />
								</span>
								<span class="num">{d.c}</span>
							</li>
						))}
					</ul>

					<div class="cal">
						<p class="cal-head">
							<span class="label">Field Notes　·　标记日历</span>
							<span class="check">[过去一年里有 {activeDays} 天留下了记录]</span>
						</p>
						<div class="heat-scroll" data-heat>
							<div class="heat" role="img" aria-label={`过去一年的标记日历，共 ${activeDays} 天有记录`}>
								{weeks.map((wk, w) => (
									<div class="wk">
										<span class="mo">{monthLabel(w)}</span>
										{wk.days.map((d) =>
											d.future ? (
												<i class="void" />
											) : (
												<i class={`l${d.lv}`} title={d.n ? `${d.key}　${d.n} 条：${d.titles.join('、')}` : d.key} />
											),
										)}
									</div>
								))}
							</div>
						</div>
						<p class="legend label" aria-hidden="true">
							少 <i class="l0" /><i class="l1" /><i class="l2" /><i class="l3" /><i class="l4" /> 多
						</p>
					</div>
				</section>
			)
		}

		<div class="filters" role="group" aria-label="筛选">
			<div class="seg" data-group="type">
				<button class="on" data-v="all">全部 <i>{items.length}</i></button>
				<button data-v="book">书 <i>{count('book')}</i></button>
				<button data-v="movie">影 <i>{count('movie')}</i></button>
				<button data-v="music">音 <i>{count('music')}</i></button>
			</div>
			<div class="seg" data-group="status">
				<button class="on" data-v="all">不限</button>
				<button data-v="done">完成</button>
				<button data-v="doing">进行</button>
				<button data-v="wish">想要</button>
			</div>
		</div>

		{
			items.length > 0 ? (
				<ul class="grid">
					{items.map((it) => (
						<li class="item" data-type={it.type} data-status={it.status}>
							<a href={it.url} target="_blank" rel="noopener noreferrer">
								<div class={`cover ${it.type}${it.cover ? ' has-img' : ''}`}>
									{it.cover && <img src={url(it.cover)} alt={it.title} loading="lazy" decoding="async" />}
									<span class="top">{statusLabel[it.type][it.status]}</span>
									<span class="title">{it.title}</span>
									<span class="kind">{typeLabel[it.type]}</span>
								</div>
								<div class="info">
									<h3>{it.title}</h3>
									{it.rating ? (
										<p class="rating">
											<span class="pips" aria-hidden="true">
												{[1, 2, 3, 4, 5].map((n) => (
													<i class={n <= it.rating! ? 'on' : ''} />
												))}
											</span>
											<span class="check">[{verdict[it.rating]}]</span>
										</p>
									) : null}
									{it.comment && <p class="comment">{it.comment}</p>}
								</div>
							</a>
						</li>
					))}
				</ul>
			) : (
				<div class="empty panel">
					<p class="big">物品栏是空的</p>
					<p>
						还没有同步到豆瓣数据。运行 <code>DOUBAN_ID=你的ID npm run sync:douban</code>，或等待每天的自动同步。
					</p>
				</div>
			)
		}
		<p class="none" hidden>这个筛选下没有内容。</p>

		<p class="credit">
			影视封面与数据来自 TMDB，图书封面来自 Open Library。This product uses the TMDB API but is not endorsed or
			certified by TMDB.
		</p>
	</main>
</Base>

<script>
	// 窄屏下日历可横向滚动，默认停在最右边（最近的日子）
	const heat = document.querySelector<HTMLElement>('[data-heat]');
	if (heat) heat.scrollLeft = heat.scrollWidth;

	const state = { type: 'all', status: 'all' };
	const items = [...document.querySelectorAll<HTMLElement>('.item')];
	const none = document.querySelector<HTMLElement>('.none');

	const apply = () => {
		let shown = 0;
		for (const el of items) {
			const ok =
				(state.type === 'all' || el.dataset.type === state.type) &&
				(state.status === 'all' || el.dataset.status === state.status);
			el.hidden = !ok;
			if (ok) shown++;
		}
		if (none) none.hidden = shown > 0 || items.length === 0;
	};

	document.querySelectorAll<HTMLElement>('.seg').forEach((seg) => {
		const group = seg.dataset.group as 'type' | 'status';
		seg.addEventListener('click', (e) => {
			const btn = (e.target as HTMLElement).closest('button');
			if (!btn) return;
			state[group] = btn.dataset.v!;
			seg.querySelectorAll('button').forEach((b) => b.classList.toggle('on', b === btn));
			apply();
		});
	});
</script>

<style>
	main {
		padding-bottom: clamp(64px, 9vw, 120px);
	}

	/* ---------- 统计 ---------- */
	.stats {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 28px 48px;
		padding: 26px 30px;
		margin-bottom: 36px;
	}
	/* ---------- 标记日历 ---------- */
	.cal {
		grid-column: 1 / -1;
		padding-top: 22px;
		border-top: 1px solid var(--line);
		min-width: 0;
	}
	.cal-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 16px;
		margin: 0 0 14px;
	}
	.cal-head .label {
		font-size: 0.7rem;
	}
	.heat-scroll {
		overflow-x: auto;
		scrollbar-width: thin;
		scrollbar-color: var(--line-2) transparent;
		padding-bottom: 6px;
	}
	.heat {
		--cell: 13px;
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: var(--cell);
		gap: 4px;
		width: max-content;
		margin-inline: auto;
	}
	.wk {
		display: grid;
		grid-template-rows: 16px repeat(7, var(--cell));
		gap: 4px;
	}
	.mo {
		font-family: var(--font-display);
		font-size: 0.66rem;
		letter-spacing: 0.06em;
		color: var(--ink-3);
		white-space: nowrap;
		line-height: 16px;
	}
	.heat i,
	.legend i {
		display: block;
		width: var(--cell, 13px);
		height: var(--cell, 13px);
		background: rgba(216, 209, 191, 0.06);
		box-shadow: inset 0 0 0 1px rgba(216, 209, 191, 0.05);
		transition: transform 0.2s var(--ease-out);
	}
	.heat i.void {
		visibility: hidden;
	}
	.heat i:not(.l0):hover {
		transform: scale(1.35);
	}
	/* 四档深浅：从一点余烬到烧透的橙 */
	.heat i.l1,
	.legend i.l1 {
		background: color-mix(in srgb, var(--orange) 30%, var(--panel));
	}
	.heat i.l2,
	.legend i.l2 {
		background: color-mix(in srgb, var(--orange) 55%, var(--panel));
	}
	.heat i.l3,
	.legend i.l3 {
		background: color-mix(in srgb, var(--orange) 82%, var(--panel));
	}
	.heat i.l4,
	.legend i.l4 {
		background: var(--orange-hi);
		box-shadow: 0 0 10px color-mix(in srgb, var(--orange) 60%, transparent);
	}
	.legend {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 4px;
		margin: 10px 0 0;
		font-size: 0.68rem;
	}
	.legend i {
		width: 11px;
		height: 11px;
	}
	.legend i:first-of-type {
		margin-left: 6px;
	}
	.legend i:last-of-type {
		margin-right: 6px;
	}

	.nums {
		display: grid;
		grid-template-columns: repeat(3, auto);
		justify-content: space-between;
		gap: 16px;
		margin: 0;
	}
	.nums dt {
		font-size: 0.7rem;
	}
	.nums dd {
		margin: 0.1em 0 0;
		font-family: var(--font-display);
		font-size: 2.6rem;
		font-weight: 700;
		line-height: 1.1;
		color: var(--ink);
	}
	.nums small {
		margin-left: 0.3em;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--ink-3);
	}
	.dist {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 5px;
		align-content: center;
	}
	.dist li {
		display: grid;
		grid-template-columns: 3.4em 1fr 1.6em;
		align-items: center;
		gap: 12px;
	}
	.dist .label {
		font-size: 0.74rem;
		letter-spacing: 0.12em;
	}
	.bar {
		height: 8px;
		background: rgba(216, 209, 191, 0.08);
	}
	.bar i {
		display: block;
		height: 100%;
		min-width: 2px;
		background: var(--orange);
	}
	.num {
		font-family: var(--font-display);
		font-size: 0.85rem;
		color: var(--ink-2);
		text-align: right;
	}

	/* ---------- 筛选 ---------- */
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 44px;
		margin-bottom: 34px;
		padding-block: 14px;
		border-block: 1px solid var(--line);
	}
	.seg {
		display: flex;
		gap: 22px;
	}
	.seg button {
		padding: 2px 0 4px;
		border: 0;
		border-bottom: 2px solid transparent;
		background: none;
		color: var(--ink-2);
		font-family: var(--font-display);
		font-size: 0.92rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		cursor: pointer;
		transition:
			color 0.2s var(--ease),
			border-color 0.3s var(--ease);
	}
	.seg button i {
		font-style: normal;
		font-size: 0.78em;
		color: var(--ink-3);
	}
	.seg button:hover {
		color: var(--orange-hi);
	}
	.seg button.on {
		color: var(--ink);
		border-bottom-color: var(--orange);
	}

	/* ---------- 网格 ---------- */
	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(158px, 1fr));
		gap: 38px 24px;
	}
	.item[hidden] {
		display: none;
	}
	.item a {
		display: block;
		color: var(--ink);
	}

	.cover {
		--c: var(--int);
		position: relative;
		display: grid;
		grid-template-rows: auto 1fr auto;
		justify-items: center;
		aspect-ratio: 2 / 3;
		padding: 16px 12px 12px;
		background:
			linear-gradient(160deg, color-mix(in srgb, var(--c) 34%, #0e1413), color-mix(in srgb, var(--c) 10%, #0e1413));
		border: 1px solid var(--line-2);
		box-shadow: var(--shadow);
		overflow: hidden;
		transition:
			transform 0.5s var(--ease-out),
			border-color 0.3s var(--ease);
	}
	.cover.movie {
		--c: var(--fys);
	}
	.cover.music {
		--c: var(--psy);
	}
	.item a:hover .cover {
		transform: translateY(-6px) rotate(-1deg);
		border-color: var(--orange);
	}
	.top,
	.kind {
		font-family: var(--font-display);
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.24em;
		color: var(--c);
	}
	.title {
		align-self: center;
		max-height: 100%;
		overflow: hidden;
		writing-mode: vertical-rl;
		font-size: 1.12rem;
		font-weight: 900;
		line-height: 1.5;
		letter-spacing: 0.26em;
	}
	/* 有真实封面时：图片铺满，只保留左上角的状态角标 */
	.cover.has-img {
		padding: 0;
		background: var(--panel);
	}
	.cover.has-img .title,
	.cover.has-img .kind {
		display: none;
	}
	.cover img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		filter: saturate(0.85) contrast(1.04);
		transition: filter 0.4s var(--ease);
	}
	.item a:hover .cover img {
		filter: none;
	}
	.cover.has-img .top {
		position: absolute;
		left: 0;
		top: 10px;
		padding: 2px 9px 2px 8px;
		background: var(--bg);
		border-left: 3px solid var(--orange);
		color: var(--ink);
		letter-spacing: 0.16em;
	}

	.info {
		padding-top: 12px;
	}
	.info h3 {
		font-size: 0.98rem;
		line-height: 1.45;
		transition: color 0.2s var(--ease);
	}
	.item a:hover h3 {
		color: var(--orange-hi);
	}
	.rating {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 6px 0 0;
	}
	.pips {
		display: inline-flex;
		gap: 4px;
	}
	.pips i {
		width: 8px;
		height: 8px;
		border: 1px solid var(--orange);
		transform: rotate(45deg);
	}
	.pips i.on {
		background: var(--orange);
	}
	.comment {
		margin: 6px 0 0;
		color: var(--ink-2);
		font-size: 0.84rem;
		line-height: 1.7;
		display: -webkit-box;
		-webkit-line-clamp: 4;
		line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.empty {
		padding: 56px 24px;
		text-align: center;
		color: var(--ink-2);
	}
	.empty .big {
		font-size: 1.4rem;
		font-weight: 900;
		color: var(--ink);
	}
	.none {
		color: var(--ink-2);
	}
	.credit {
		margin-top: 72px;
		padding-top: 18px;
		border-top: 1px solid var(--line);
		font-family: var(--font-sans);
		font-size: 0.72rem;
		line-height: 1.8;
		color: var(--ink-3);
	}

	@media (max-width: 860px) {
		.stats {
			grid-template-columns: 1fr;
			padding: 22px;
		}
		.nums {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
