---
import Base from '../layouts/Base.astro';
import data from '../data/douban.json';
import { SITE_TITLE, url } from '../consts';

type Item = {
	type: 'book' | 'movie' | 'music';
	status: 'wish' | 'doing' | 'done';
	title: string;
	url: string;
	/** 本站内的封面路径（public/ 下），没有时显示题字封面 */
	cover?: string;
	rating?: number; // 1-5
	comment?: string;
	date: string;
};

const items = (data.items as Item[]).slice().sort((a, b) => b.date.localeCompare(a.date));

const typeLabel = { book: '书', movie: '影', music: '音' } as const;
const statusLabel = {
	book: { wish: '想读', doing: '在读', done: '读过' },
	movie: { wish: '想看', doing: '在看', done: '看过' },
	music: { wish: '想听', doing: '在听', done: '听过' },
} as const;

const count = (t: string) => items.filter((i) => i.type === t).length;
const updated = data.updated ? new Date(data.updated) : null;
---

<Base title={`书影音 · ${SITE_TITLE}`} description="我在豆瓣上标记的书、电影和音乐，每天自动同步。">
	<main class="container">
		<header class="head">
			<p class="label reveal">书　影　音</p>
			<h1 class="reveal" style="--d:.08s">读过的，看过的，听过的</h1>
			<p class="intro reveal" style="--d:.16s">
				数据来自豆瓣，每天自动同步。
				{updated && <span>最近一次：{updated.toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai' })}</span>}
			</p>
		</header>

		<div class="filters label" role="group" aria-label="筛选">
			<div class="seg" data-group="type">
				<button class="on" data-v="all">全部 {items.length}</button>
				<button data-v="book">书 {count('book')}</button>
				<button data-v="movie">影 {count('movie')}</button>
				<button data-v="music">音 {count('music')}</button>
			</div>
			<div class="seg" data-group="status">
				<button class="on" data-v="all">不限</button>
				<button data-v="done">完成</button>
				<button data-v="doing">进行</button>
				<button data-v="wish">想要</button>
			</div>
		</div>

		{
			items.length > 0 ? (
				<ul class="grid">
					{items.map((it) => (
						<li class="item" data-type={it.type} data-status={it.status}>
							<a href={it.url} target="_blank" rel="noopener noreferrer">
								<div class={`cover ${it.type}${it.cover ? ' has-img' : ''}`}>
									{it.cover && <img src={url(it.cover)} alt={it.title} loading="lazy" decoding="async" />}
									<span class="top label">{statusLabel[it.type][it.status]}</span>
									<span class="title">{it.title}</span>
									<span class="kind label">{typeLabel[it.type]}</span>
								</div>
								<div class="info">
									{it.rating ? (
										<p class="stars" aria-label={`${it.rating} 星`}>
											{'★'.repeat(it.rating)}
											<span>{'★'.repeat(5 - it.rating)}</span>
										</p>
									) : null}
									{it.comment && <p class="comment">{it.comment}</p>}
								</div>
							</a>
						</li>
					))}
				</ul>
			) : (
				<div class="empty">
					<p class="big">这里还是一片空白的海滩</p>
					<p>
						还没有同步到豆瓣数据。运行 <code>DOUBAN_ID=你的ID npm run sync:douban</code>，或等待每天的自动同步。
					</p>
				</div>
			)
		}
		<p class="none" hidden>这个筛选下没有内容。</p>

		<p class="credit label">
			影视封面与数据来自 TMDB，图书封面来自 Open Library。This product uses the TMDB API but is not endorsed
			or certified by TMDB.
		</p>
	</main>
</Base>

<script>
	const state = { type: 'all', status: 'all' };
	const items = [...document.querySelectorAll<HTMLElement>('.item')];
	const none = document.querySelector<HTMLElement>('.none');

	const apply = () => {
		let shown = 0;
		for (const el of items) {
			const ok =
				(state.type === 'all' || el.dataset.type === state.type) &&
				(state.status === 'all' || el.dataset.status === state.status);
			el.hidden = !ok;
			if (ok) shown++;
		}
		if (none) none.hidden = shown > 0 || items.length === 0;
	};

	document.querySelectorAll<HTMLElement>('.seg').forEach((seg) => {
		const group = seg.dataset.group as 'type' | 'status';
		seg.addEventListener('click', (e) => {
			const btn = (e.target as HTMLElement).closest('button');
			if (!btn) return;
			state[group] = btn.dataset.v!;
			seg.querySelectorAll('button').forEach((b) => b.classList.toggle('on', b === btn));
			apply();
		});
	});
</script>

<style>
	main {
		padding-block: clamp(56px, 9vw, 112px) clamp(72px, 10vw, 130px);
	}
	.head h1 {
		margin-top: 0.5em;
		font-size: clamp(2rem, 5.4vw, 3.2rem);
		font-weight: 400;
		letter-spacing: 0.16em;
	}
	.intro {
		margin: 1em 0 0;
		color: var(--text-2);
		font-size: 0.95rem;
		letter-spacing: 0.12em;
	}
	.intro span {
		margin-left: 1.2em;
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 40px;
		margin: 48px 0 40px;
		padding-block: 16px;
		border-block: 1px solid var(--line);
	}
	.seg {
		display: flex;
		gap: 22px;
	}
	.seg button {
		padding: 0 0 3px;
		border: 0;
		border-bottom: 1px solid transparent;
		background: none;
		color: var(--text-2);
		font: inherit;
		letter-spacing: inherit;
		cursor: pointer;
		transition:
			color 0.3s var(--ease),
			border-color 0.4s var(--ease);
	}
	.seg button:hover {
		color: var(--text);
	}
	.seg button.on {
		color: var(--text);
		border-bottom-color: var(--text);
	}

	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
		gap: 40px 28px;
	}
	.item[hidden] {
		display: none;
	}
	.item a {
		display: block;
		color: var(--text);
	}

	/* ---------- 题字封面：纸色 + 竖排书名 + 内框细线 ---------- */
	.cover {
		--paper: #e9dfcf;
		--ink: #4b4032;
		position: relative;
		display: grid;
		grid-template-rows: auto 1fr auto;
		justify-items: center;
		aspect-ratio: 2 / 3;
		padding: 18px 12px 14px;
		background: var(--paper);
		color: var(--ink);
		box-shadow: var(--shadow);
		overflow: hidden;
		transition:
			transform 0.7s var(--ease-out),
			box-shadow 0.7s var(--ease-out);
	}
	.cover::before {
		content: '';
		position: absolute;
		inset: 8px;
		border: 1px solid color-mix(in srgb, var(--ink) 32%, transparent);
		pointer-events: none;
	}
	.cover.movie {
		--paper: #d3e0e4;
		--ink: #2f4a56;
	}
	.cover.music {
		--paper: #dbe0cf;
		--ink: #3d4a35;
	}
	@media (prefers-color-scheme: dark) {
		.cover {
			--paper: #2b2a26;
			--ink: #d9cfbf;
		}
		.cover.movie {
			--paper: #1c2a31;
			--ink: #b6ccd5;
		}
		.cover.music {
			--paper: #232a20;
			--ink: #c4cdb8;
		}
	}
	.item a:hover .cover {
		transform: translateY(-6px);
		box-shadow: var(--shadow-hover);
	}
	.cover .label {
		color: inherit;
		opacity: 0.7;
		font-size: 0.7rem;
		letter-spacing: 0.3em;
	}
	/* 有真实封面时：图片铺满，只保留左上角的状态角标 */
	.cover.has-img {
		padding: 0;
		background: var(--bg-alt);
	}
	.cover.has-img::before,
	.cover.has-img .title,
	.cover.has-img .kind {
		display: none;
	}
	.cover img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.cover.has-img .top {
		position: absolute;
		left: 8px;
		top: 8px;
		padding: 1px 8px;
		background: rgba(20, 20, 20, 0.55);
		-webkit-backdrop-filter: blur(6px);
		backdrop-filter: blur(6px);
		color: #fff;
		opacity: 1;
		letter-spacing: 0.2em;
	}
	.credit {
		margin-top: 72px;
		padding-top: 20px;
		border-top: 1px solid var(--line);
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		line-height: 1.8;
		opacity: 0.8;
	}
	.title {
		align-self: center;
		max-height: 100%;
		overflow: hidden;
		writing-mode: vertical-rl;
		font-size: 1.15rem;
		font-weight: 500;
		line-height: 1.5;
		letter-spacing: 0.3em;
		text-align: start;
	}

	.info {
		padding-top: 12px;
	}
	.stars {
		margin: 0;
		color: var(--accent);
		font-size: 0.7rem;
		letter-spacing: 3px;
		line-height: 1.4;
	}
	.stars span {
		opacity: 0.2;
	}
	.comment {
		margin: 6px 0 0;
		color: var(--text-2);
		font-size: 0.82rem;
		line-height: 1.7;
		letter-spacing: 0.04em;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.empty {
		padding: 64px 24px;
		border: 1px solid var(--line);
		text-align: center;
		color: var(--text-2);
	}
	.empty .big {
		font-size: 1.4rem;
		color: var(--text);
		letter-spacing: 0.12em;
	}
	.none {
		color: var(--text-2);
	}
</style>
