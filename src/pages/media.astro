---
import Base from '../layouts/Base.astro';
import data from '../data/douban.json';

type Item = {
	type: 'book' | 'movie' | 'music';
	status: 'wish' | 'doing' | 'done';
	title: string;
	url: string;
	cover?: string;
	rating?: number; // 1-5
	comment?: string;
	date: string;
};

const items = (data.items as Item[]).slice().sort((a, b) => b.date.localeCompare(a.date));

const typeLabel = { book: '书', movie: '影', music: '音' } as const;
const statusLabel = {
	book: { wish: '想读', doing: '在读', done: '读过' },
	movie: { wish: '想看', doing: '在看', done: '看过' },
	music: { wish: '想听', doing: '在听', done: '听过' },
} as const;

const count = (t: string) => items.filter((i) => i.type === t).length;
const updated = data.updated ? new Date(data.updated) : null;
---

<Base title="书影音 · 小海湾" description="我在豆瓣上标记的书、电影和音乐，每天自动同步。">
	<main class="container">
		<header class="head">
			<h1>书影音</h1>
			<p>
				读过的书，看过的光影，听过的旋律。数据来自豆瓣，每天自动同步。
				{updated && <span class="sync">最近同步：{updated.toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai' })}</span>}
			</p>
		</header>

		<div class="filters" role="group" aria-label="筛选">
			<div class="seg" data-group="type">
				<button class="on" data-v="all">全部 <i>{items.length}</i></button>
				<button data-v="book">书 <i>{count('book')}</i></button>
				<button data-v="movie">影 <i>{count('movie')}</i></button>
				<button data-v="music">音 <i>{count('music')}</i></button>
			</div>
			<div class="seg" data-group="status">
				<button class="on" data-v="all">全部状态</button>
				<button data-v="done">已完成</button>
				<button data-v="doing">进行中</button>
				<button data-v="wish">想要</button>
			</div>
		</div>

		{
			items.length > 0 ? (
				<ul class="grid">
					{items.map((it) => (
						<li class="item" data-type={it.type} data-status={it.status}>
							<a href={it.url} target="_blank" rel="noopener noreferrer">
								<div class="cover">
									{it.cover ? (
										<img src={it.cover} alt="" loading="lazy" referrerpolicy="no-referrer" />
									) : (
										<span class="ph">{typeLabel[it.type]}</span>
									)}
									<span class="badge">{statusLabel[it.type][it.status]}</span>
								</div>
								<h3>{it.title}</h3>
								{it.rating ? <p class="stars" aria-label={`${it.rating} 星`}>{'★'.repeat(it.rating)}{'☆'.repeat(5 - it.rating)}</p> : null}
								{it.comment && <p class="comment">{it.comment}</p>}
							</a>
						</li>
					))}
				</ul>
			) : (
				<div class="empty">
					<p class="big">这里还是一片空白海滩 🏖️</p>
					<p>
						还没有同步到豆瓣数据。设置好你的豆瓣 ID 后，运行
						<code>DOUBAN_ID=你的ID npm run sync:douban</code>，或等待 GitHub Actions 每天自动同步。
					</p>
				</div>
			)
		}
		<p class="none" hidden>这个筛选下没有内容。</p>
	</main>
</Base>

<script>
	const state = { type: 'all', status: 'all' };
	const items = [...document.querySelectorAll<HTMLElement>('.item')];
	const none = document.querySelector<HTMLElement>('.none');

	const apply = () => {
		let shown = 0;
		for (const el of items) {
			const ok =
				(state.type === 'all' || el.dataset.type === state.type) &&
				(state.status === 'all' || el.dataset.status === state.status);
			el.hidden = !ok;
			if (ok) shown++;
		}
		if (none) none.hidden = shown > 0 || items.length === 0;
	};

	document.querySelectorAll<HTMLElement>('.seg').forEach((seg) => {
		const group = seg.dataset.group as 'type' | 'status';
		seg.addEventListener('click', (e) => {
			const btn = (e.target as HTMLElement).closest('button');
			if (!btn) return;
			state[group] = btn.dataset.v!;
			seg.querySelectorAll('button').forEach((b) => b.classList.toggle('on', b === btn));
			apply();
		});
	});
</script>

<style>
	main {
		padding-block: clamp(48px, 8vw, 96px) clamp(64px, 10vw, 120px);
	}
	.head h1 {
		font-size: clamp(2.6rem, 7vw, 4.4rem);
		letter-spacing: -0.045em;
	}
	.head p {
		margin: 0.5em 0 0;
		max-width: 640px;
		color: var(--text-2);
		font-size: 1.15rem;
	}
	.sync {
		display: block;
		margin-top: 0.3em;
		font-size: 0.9rem;
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 14px 24px;
		margin: 36px 0 32px;
	}
	.seg {
		display: inline-flex;
		padding: 4px;
		border-radius: 999px;
		background: var(--bg-alt);
	}
	.seg button {
		padding: 6px 16px;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--text-2);
		font: inherit;
		font-size: 0.9rem;
		cursor: pointer;
		transition:
			background 0.3s var(--ease),
			color 0.3s var(--ease),
			box-shadow 0.3s var(--ease);
	}
	.seg button i {
		font-style: normal;
		font-size: 0.75rem;
		opacity: 0.7;
	}
	.seg button.on {
		background: var(--surface);
		color: var(--text);
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
	}

	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
		gap: 28px 20px;
	}
	.item[hidden] {
		display: none;
	}
	.item a {
		display: block;
		color: var(--text);
	}
	.item a:hover {
		text-decoration: none;
	}
	.cover {
		position: relative;
		aspect-ratio: 2 / 3;
		border-radius: 14px;
		overflow: hidden;
		background: linear-gradient(160deg, var(--sea-1), var(--sea-2));
		box-shadow: var(--shadow);
		transition:
			transform 0.6s var(--ease-out),
			box-shadow 0.6s var(--ease-out);
	}
	.item a:hover .cover {
		transform: translateY(-6px) scale(1.03);
		box-shadow: var(--shadow-hover);
	}
	.cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.ph {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		font-size: 2.4rem;
		font-weight: 700;
		color: rgba(255, 255, 255, 0.85);
	}
	.badge {
		position: absolute;
		left: 8px;
		top: 8px;
		padding: 2px 9px;
		border-radius: 999px;
		background: rgba(0, 0, 0, 0.55);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
		color: #fff;
		font-size: 0.72rem;
	}
	.item h3 {
		margin: 10px 0 2px;
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.01em;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.stars {
		margin: 0;
		color: #ff9f0a;
		font-size: 0.8rem;
		letter-spacing: 1px;
	}
	.comment {
		margin: 4px 0 0;
		color: var(--text-2);
		font-size: 0.8rem;
		line-height: 1.45;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.empty {
		padding: 56px 24px;
		border-radius: 28px;
		background: var(--bg-alt);
		text-align: center;
		color: var(--text-2);
	}
	.empty .big {
		font-size: 1.5rem;
		font-weight: 600;
		color: var(--text);
	}
	.none {
		color: var(--text-2);
	}
</style>
