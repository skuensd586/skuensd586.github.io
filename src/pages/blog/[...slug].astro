---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { url } from '../../consts';
import { getPosts, readingMinutes } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts(); // 新 → 旧
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { post, older: posts[i + 1] ?? null, newer: posts[i - 1] ?? null },
	}));
}
type Entry = CollectionEntry<'blog'>;
type Props = { post: Entry; older: Entry | null; newer: Entry | null };

const { post, older, newer } = Astro.props;
const { Content, headings } = await render(post);
const link = (p: Entry | null) => (p ? { title: p.data.title, href: url(`blog/${p.id}/`) } : null);
---

<BlogPost {...post.data} minutes={readingMinutes(post.body)} headings={headings} prev={link(older)} next={link(newer)}>
	<Content />
</BlogPost>
