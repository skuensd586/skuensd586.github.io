---
import FormattedDate from '../../components/FormattedDate.astro';
import Base from '../../layouts/Base.astro';
import { url } from '../../consts';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();

// 按年份分组（已是倒序）
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.data.pubDate.getFullYear();
	byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
---

<Base title="文章 · 小海湾" description="所有文章，按时间倒序排列。">
	<main class="container">
		<header class="head">
			<h1>文章</h1>
			<p>共 {posts.length} 篇。</p>
		</header>

		{
			[...byYear].map(([year, list]) => (
				<section>
					<h2 class="year reveal">{year}</h2>
					<ul>
						{list.map((post, i) => (
							<li class="reveal" style={`--d:${Math.min(i, 4) * 0.06}s`}>
								<a href={url(`blog/${post.id}/`)}>
									<div class="meta">
										<FormattedDate date={post.data.pubDate} />
										{post.data.draft && <span class="draft">草稿</span>}
									</div>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
									{post.data.tags.length > 0 && (
										<ul class="tags">
											{post.data.tags.map((t) => (
												<li>{t}</li>
											))}
										</ul>
									)}
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}

		{posts.length === 0 && <p class="empty">还没有文章。运行 <code>npm run new "标题"</code> 写下第一篇吧。</p>}
	</main>
</Base>

<style>
	main {
		max-width: 820px;
		padding-block: clamp(48px, 8vw, 96px) clamp(64px, 10vw, 120px);
	}
	.head {
		margin-bottom: clamp(32px, 6vw, 64px);
	}
	.head h1 {
		font-size: clamp(2.6rem, 7vw, 4.4rem);
		letter-spacing: -0.045em;
	}
	.head p {
		margin: 0.4em 0 0;
		color: var(--text-2);
		font-size: 1.15rem;
	}
	.year {
		margin: 1.6em 0 0.5em;
		font-size: 1rem;
		font-weight: 600;
		color: var(--text-2);
		letter-spacing: 0.02em;
	}
	section > ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 16px;
	}
	section > ul > li > a {
		display: block;
		padding: 28px 30px;
		border-radius: 24px;
		background: var(--surface);
		box-shadow: var(--shadow);
		color: var(--text);
		transition:
			transform 0.6s var(--ease-out),
			box-shadow 0.6s var(--ease-out);
	}
	section > ul > li > a:hover {
		transform: translateY(-4px) scale(1.01);
		box-shadow: var(--shadow-hover);
		text-decoration: none;
	}
	.meta {
		font-size: 0.82rem;
		color: var(--text-2);
		display: flex;
		gap: 10px;
		align-items: center;
	}
	.draft {
		padding: 1px 8px;
		border-radius: 999px;
		background: #ff9f0a;
		color: #fff;
		font-size: 0.72rem;
	}
	h3 {
		margin: 0.35em 0 0.25em;
		font-size: 1.6rem;
	}
	section > ul > li > a p {
		margin: 0;
		color: var(--text-2);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		list-style: none;
		margin: 14px 0 0;
		padding: 0;
	}
	.tags li {
		padding: 2px 12px;
		border-radius: 999px;
		background: var(--bg-alt);
		color: var(--text-2);
		font-size: 0.8rem;
	}
	.empty {
		color: var(--text-2);
	}
</style>
