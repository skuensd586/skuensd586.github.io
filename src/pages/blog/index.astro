---
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { SITE_TITLE, url } from '../../consts';
import { getPosts, getTags } from '../../lib/posts';

const posts = await getPosts();
const tags = await getTags();
---

<Base title={`文章 · ${SITE_TITLE}`} description="所有文章，按时间倒序排列。">
	<main class="container">
		<header class="page-head">
			<span class="label reveal">Journal　·　案卷</span>
			<h1 class="reveal" style="--d:.08s">写下来的话</h1>
			<p class="lede reveal" style="--d:.16s">共 {posts.length} 篇。未完成的，也算在内。</p>
		</header>

		{
			tags.length > 0 && (
				<p class="tags reveal">
					{tags.map((t) => (
						<a href={url(`tags/${encodeURIComponent(t.name)}/`)}>
							#{t.name}
							<i>{t.count}</i>
						</a>
					))}
				</p>
			)
		}

		<PostList posts={posts} />
		{posts.length === 0 && <p class="empty">还没有文章。运行 <code>npm run new "标题"</code> 写下第一篇。</p>}
	</main>
</Base>

<style>
	main {
		max-width: 860px;
		padding-bottom: clamp(64px, 9vw, 120px);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		margin: 0 0 2.6em;
		font-family: var(--font-display);
		letter-spacing: 0.08em;
	}
	.tags i {
		margin-left: 0.35em;
		font-style: normal;
		font-size: 0.8em;
		color: var(--ink-3);
	}
	.empty {
		color: var(--ink-2);
	}
</style>
