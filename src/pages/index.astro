---
import FormattedDate from '../components/FormattedDate.astro';
import Wave from '../components/Wave.astro';
import Base from '../layouts/Base.astro';
import { SITE_DESCRIPTION, SITE_TITLE, url } from '../consts';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 4);

const index = [
	{ no: '壹', name: '文章', note: '写下来的话', href: url('blog/') },
	{ no: '贰', name: '书影音', note: '读过的书，看过的光影', href: url('media/') },
	{ no: '叁', name: '关于', note: '一份简短的自述', href: url('about/') },
];
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main>
		<!-- ========== 首屏：一句话，和远处的海 ========== -->
		<section class="hero">
			<div class="disc" aria-hidden="true"></div>

			<div class="hero-text container">
				<p class="eyebrow label">札记　·　阅读　·　观影</p>
				<h1>
					<span class="line">海是慢的，</span>
					<span class="line">字也是。</span>
				</h1>
				<p class="sub">一些写下来的话，和读过、看过的光影。</p>
				<p class="cta">
					<a class="link" href={url('blog/')}>读文章</a>
					<a class="link" href={url('media/')}>看书影音</a>
				</p>
			</div>

			<!-- 从远到近：四层雾蓝的海 -->
			<div class="layer l1" data-parallax="0.05">
				<Wave color="var(--wave-1)" height="46%" duration={46} bob={9} />
			</div>
			<div class="layer l2" data-parallax="0.1">
				<Wave color="var(--wave-2)" height="36%" duration={38} bob={7.5} reverse delay="-2s" />
			</div>
			<div class="layer l3" data-parallax="0.17">
				<Wave color="var(--wave-3)" height="25%" duration={30} bob={6} delay="-4s" />
			</div>
			<div class="layer l4" data-parallax="0.26">
				<Wave color="var(--wave-4)" height="15%" duration={24} bob={5} reverse delay="-1s" />
			</div>
		</section>

		<!-- ========== 逐词浮现的一段话 ========== -->
		<section class="statement container">
			<p data-words>
				在这里，我写代码，也写日子；读一本书，看一部电影，把它们慢慢留下来。每一篇都不着急，像潮水一样，来了又走，留下一点点光。
			</p>
		</section>

		<!-- ========== 目录 ========== -->
		<section class="toc container" aria-label="目录">
			<p class="label reveal">目　录</p>
			<ol>
				{
					index.map((it, i) => (
						<li class="reveal" style={`--d:${i * 0.1}s`}>
							<a href={it.href}>
								<span class="no">{it.no}</span>
								<span class="name">{it.name}</span>
								<span class="note">{it.note}</span>
								<span class="arrow" aria-hidden="true">→</span>
							</a>
						</li>
					))
				}
			</ol>
		</section>

		<!-- ========== 近作 ========== -->
		<section class="latest container">
			<p class="label reveal">近　作</p>
			<ul>
				{
					posts.map((post, i) => (
						<li class="reveal" style={`--d:${i * 0.08}s`}>
							<a href={url(`blog/${post.id}/`)}>
								<time class="date label">
									<FormattedDate date={post.data.pubDate} />
								</time>
								<div>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
								</div>
							</a>
						</li>
					))
				}
			</ul>
			{posts.length === 0 && <p class="empty">还没有文章。</p>}
			<p class="all reveal"><a class="link" href={url('blog/')}>全部文章</a></p>
		</section>
	</main>
</Base>

<style>
	/* ---------- 首屏 ---------- */
	.hero {
		position: relative;
		height: calc(100svh - var(--nav-h));
		min-height: 600px;
		max-height: 940px;
		overflow: hidden;
		background: linear-gradient(180deg, var(--bg) 0%, var(--sky) 100%);
		isolation: isolate;
	}

	/* 一轮淡淡的日／月 */
	.disc {
		position: absolute;
		top: 16%;
		right: 18%;
		width: clamp(70px, 10vw, 128px);
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--sun);
		opacity: 0.85;
		animation: breathe 9s ease-in-out infinite;
	}
	@keyframes breathe {
		0%,
		100% {
			transform: scale(1);
			opacity: 0.8;
		}
		50% {
			transform: scale(1.05);
			opacity: 1;
		}
	}

	.hero-text {
		position: relative;
		z-index: 5;
		padding-top: clamp(48px, 11vh, 120px);
		text-align: center;
	}
	.eyebrow {
		margin: 0 0 2.2em;
		animation: rise 1.6s var(--ease-out) both;
	}
	h1 {
		font-size: clamp(2.4rem, 7.2vw, 5rem);
		font-weight: 400;
		line-height: 1.5;
		letter-spacing: 0.14em;
	}
	.line {
		display: block;
		animation: rise 1.8s var(--ease-out) both;
	}
	.line:nth-child(1) {
		animation-delay: 0.15s;
	}
	.line:nth-child(2) {
		animation-delay: 0.4s;
	}
	.sub {
		margin: 2em 0 0;
		color: var(--text-2);
		font-size: clamp(0.95rem, 1.8vw, 1.15rem);
		letter-spacing: 0.2em;
		animation: rise 1.8s var(--ease-out) 0.7s both;
	}
	.cta {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 12px 40px;
		margin: 2.4em 0 0;
		animation: rise 1.8s var(--ease-out) 0.95s both;
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(24px);
			filter: blur(6px);
		}
		to {
			opacity: 1;
			transform: none;
			filter: none;
		}
	}

	/* 图层：外层负责滚动视差，内层各自起伏漂移 */
	.layer {
		position: absolute;
		inset: 0;
		transform: translate3d(0, var(--py, 0px), 0);
		pointer-events: none;
	}
	.l1 {
		z-index: 1;
	}
	.l2 {
		z-index: 2;
	}
	.l3 {
		z-index: 3;
	}
	.l4 {
		z-index: 4;
	}

	/* ---------- 一段话 ---------- */
	.statement {
		max-width: 800px;
		padding: clamp(96px, 16vw, 200px) 0;
	}
	.statement p {
		margin: 0;
		font-size: clamp(1.4rem, 3.6vw, 2.2rem);
		font-weight: 400;
		line-height: 2;
		letter-spacing: 0.1em;
	}
	.statement :global(.w) {
		transition: opacity 0.7s var(--ease);
	}
	.statement :global(.words-ready .w) {
		opacity: 0.16;
	}
	.statement :global(.words-ready .w.on) {
		opacity: 1;
	}

	/* ---------- 目录 ---------- */
	.toc,
	.latest {
		max-width: 800px;
	}
	.toc {
		padding-bottom: clamp(72px, 12vw, 140px);
	}
	.toc ol,
	.latest ul {
		list-style: none;
		margin: 0.6em 0 0;
		padding: 0;
	}
	.toc li a {
		display: grid;
		grid-template-columns: 3.2em 8em 1fr auto;
		align-items: baseline;
		gap: 8px;
		padding: 26px 0;
		border-top: 1px solid var(--line);
		color: var(--text);
		transition: padding-left 0.6s var(--ease-out);
	}
	.toc li:last-child a {
		border-bottom: 1px solid var(--line);
	}
	.toc li a:hover {
		padding-left: 14px;
		color: var(--accent);
	}
	.no {
		color: var(--text-2);
		font-size: 0.95rem;
	}
	.name {
		font-size: 1.5rem;
		letter-spacing: 0.2em;
	}
	.note {
		color: var(--text-2);
		font-size: 0.92rem;
	}
	.arrow {
		opacity: 0;
		transform: translateX(-8px);
		transition:
			opacity 0.4s var(--ease),
			transform 0.6s var(--ease-out);
	}
	.toc li a:hover .arrow {
		opacity: 1;
		transform: none;
	}

	/* ---------- 近作 ---------- */
	.latest {
		padding-bottom: clamp(80px, 12vw, 150px);
	}
	.latest li a {
		display: grid;
		grid-template-columns: 9.5em 1fr;
		gap: 12px 24px;
		padding: 30px 0;
		border-top: 1px solid var(--line);
		color: var(--text);
	}
	.latest li:last-child a {
		border-bottom: 1px solid var(--line);
	}
	.latest li a:hover h3 {
		color: var(--accent);
	}
	.latest .date {
		padding-top: 0.5em;
	}
	.latest h3 {
		font-size: 1.35rem;
		transition: color 0.3s var(--ease);
	}
	.latest li p {
		margin: 0.4em 0 0;
		color: var(--text-2);
		font-size: 0.95rem;
	}
	.all {
		margin-top: 2em;
		text-align: right;
	}
	.empty {
		color: var(--text-2);
	}

	@media (max-width: 720px) {
		.toc li a {
			grid-template-columns: 2.6em 1fr auto;
		}
		.note {
			display: none;
		}
		.latest li a {
			grid-template-columns: 1fr;
			gap: 2px;
		}
		.disc {
			right: 10%;
		}
	}
</style>
