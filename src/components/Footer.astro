---
import { NAV, SITE_TITLE, url } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<div class="container">
		<p class="links label">
			{NAV.map((n) => <a href={url(n.path)}>{n.name}</a>)}
			<a href={url('tags/')}>标签</a>
			<a href={url('search/')}>搜索</a>
			<a href={url('rss.xml')}>RSS</a>
		</p>
		<!-- 见过竹节虫的访客才会看到这一行 -->
		<p class="crypto label" data-crypto hidden>✓ 神秘动物学：你见过伊苏林迪竹节虫</p>
		<p class="copy">© {year} {SITE_TITLE}　·　界面风格致敬《极乐迪斯科》，画面为本站原创绘制，未使用游戏素材。</p>
	</div>
</footer>

<script>
	const el = document.querySelector<HTMLElement>('[data-crypto]');
	const show = () => el && (el.hidden = false);
	try {
		if (localStorage.getItem('phasmid-seen')) show();
	} catch {}
	document.addEventListener('phasmid-seen', show);
</script>

<style>
	footer {
		margin-top: 40px;
		padding: 44px 0 96px;
		border-top: 1px solid var(--line);
		color: var(--ink-3);
	}
	p {
		margin: 0 0 1em;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 26px;
	}
	.links a {
		color: var(--ink-2);
	}
	.links a:hover {
		color: var(--orange-hi);
	}
	.crypto {
		color: var(--mot);
	}
	.copy {
		font-size: 0.8rem;
		letter-spacing: 0.06em;
	}
</style>
