---
import { SITE_TITLE, url } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<div class="container">
		<svg class="rule" viewBox="0 0 120 12" aria-hidden="true">
			<path d="M0 6C10 0 20 12 30 6S50 0 60 6S80 12 90 6S110 0 120 6" fill="none" stroke="currentColor" stroke-width="1"></path>
		</svg>
		<p class="links label">
			<a href={url('blog/')}>文章</a>
			<a href={url('media/')}>书影音</a>
			<a href={url('about/')}>关于</a>
			<a href={url('rss.xml')}>订阅</a>
		</p>
		<p class="copy label">© {year} {SITE_TITLE}</p>
	</div>
</footer>

<style>
	footer {
		padding: 64px 0 88px;
		text-align: center;
		color: var(--text-2);
	}
	.rule {
		width: 96px;
		margin-bottom: 20px;
		opacity: 0.6;
	}
	p {
		margin: 0 0 0.8em;
	}
	.links {
		display: flex;
		justify-content: center;
		gap: 28px;
	}
	.links a {
		color: var(--text-2);
	}
	.links a:hover {
		color: var(--text);
	}
	.copy {
		opacity: 0.75;
	}
</style>
