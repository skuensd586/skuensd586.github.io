---
// 程序化生成的「油画」：黄昏的海岸。
// 每一道都是一笔带粗细、角度和颜色抖动的笔触，用固定种子的伪随机数生成，
// 所以每次构建画面一致。画面拆成多张叠放的 SVG：天空静止，海面分层缓慢横移
//（对整张 SVG 做 CSS transform，由合成器处理，不会逐帧重绘几百条路径）。
//
// 芦苇丛里藏着一只伊苏林迪竹节虫：默认不可见，由首页脚本在访客静止不动时显现。

interface Props {
	seed?: number;
}

const W = 1600;
const H = 900;
const HZ = 470; // 海平线

function rng(seed: number) {
	let a = seed >>> 0;
	return () => {
		a = (a + 0x6d2b79f5) | 0;
		let t = Math.imul(a ^ (a >>> 15), 1 | a);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}
const R = rng(Astro.props.seed ?? 11);
const r = (a: number, b: number) => a + (b - a) * R();
const pick = <T,>(arr: T[]) => arr[Math.floor(R() * arr.length)];
const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

type Stroke = { d: string; c: string; w: number; o: number };

/** 一笔：以 (x,y) 为中心、长 len、粗 th、倾角 rot 的微弯线段 */
function stroke(x: number, y: number, len: number, th: number, rot: number, c: string, o = 1, bend = 0.1): Stroke {
	const a = (rot * Math.PI) / 180;
	const dx = (Math.cos(a) * len) / 2;
	const dy = (Math.sin(a) * len) / 2;
	const k = len * bend * (R() - 0.5) * 2;
	const f = (n: number) => n.toFixed(0);
	return {
		d: `M${f(x - dx)} ${f(y - dy)}Q${f(x - Math.sin(a) * k)} ${f(y + Math.cos(a) * k)} ${f(x + dx)} ${f(y + dy)}`,
		c,
		w: Math.max(1, Math.round(th)),
		o: Math.round(o * 100) / 100,
	};
}

// ---------- 天空 ----------
const SKY_TOP = ['#142c2c', '#1a3a3b', '#204646', '#173334', '#25504f'];
const SKY_MID = ['#2c6663', '#3a7f7a', '#47948a', '#2a5b5b', '#56a595'];
const SKY_LOW = ['#d9a05b', '#e6bd80', '#c9824a', '#efd3a0', '#b9623a', '#e2ad6a'];
const sky: Stroke[] = [];
for (let i = 0; i < 230; i++) {
	const y = r(-30, HZ + 6);
	const t = Math.max(0, y / HZ);
	let pal = t < 0.38 ? SKY_TOP : t < 0.72 ? SKY_MID : SKY_LOW;
	if (t >= 0.38 && t < 0.72 && R() < 0.14) pal = SKY_LOW;
	if (t >= 0.72 && R() < 0.22) pal = SKY_MID;
	if (t < 0.38 && R() < 0.12) pal = SKY_MID;
	sky.push(stroke(r(-80, W + 80), y, r(150, 430), r(24, 60), r(-10, 4), pick(pal), r(0.7, 1)));
}
// 铁锈色的云
for (let i = 0; i < 18; i++) {
	sky.push(stroke(r(0, W), r(110, 380), r(200, 560), r(12, 34), r(-7, 1), pick(['#b5512c', '#8f3f25', '#d27a45', '#5a2a22', '#a2472a']), r(0.5, 0.85), 0.05));
}
// 太阳：一团厚涂的暖色
const SUN = { x: 800, y: 350 };
for (let i = 0; i < 44; i++) {
	const ang = r(0, Math.PI * 2);
	const rad = Math.pow(R(), 0.8) * 86;
	sky.push(
		stroke(SUN.x + Math.cos(ang) * rad * 1.5, SUN.y + Math.sin(ang) * rad * 0.8, r(50, 130), r(14, 32), r(-14, 10),
			pick(['#f6e2b0', '#f2c97c', '#fff1cf', '#eeb561', '#f9dca0']), r(0.6, 0.95)),
	);
}

// ---------- 远岸的剪影：楼群、起重机、低矮的对岸 ----------
const shore: Stroke[] = [];
const DARK = ['#0f2221', '#132b29', '#0c1b1b', '#18332f'];
let bx = -20;
while (bx < 760) {
	const w = r(24, 62);
	const h = bx < 420 ? r(34, 128) : r(16, 62);
	shore.push(stroke(bx + w / 2, HZ - h / 2 + 4, h, w, 90 + r(-2, 2), pick(DARK), 0.97, 0));
	if (R() < 0.5) shore.push(stroke(bx + w / 2 + r(-8, 8), HZ - h * r(0.3, 0.8), 5, 5, 0, pick(['#e9b765', '#f2c97c', '#d9853f']), 0.9, 0));
	bx += w * r(0.7, 1.05);
}
// 起重机
shore.push(stroke(596, HZ - 96, 190, 6, 90, '#0c1b1b', 1, 0));
shore.push(stroke(640, HZ - 178, 150, 5, -8, '#0c1b1b', 1, 0));
shore.push(stroke(700, HZ - 150, 70, 2, 90, '#0c1b1b', 0.9, 0));
for (let x = 1120; x < W + 40; x += r(40, 90)) {
	shore.push(stroke(x, HZ - r(2, 14), r(60, 160), r(10, 26), r(-3, 3), pick(DARK), 0.95, 0.03));
}

// ---------- 海：四层，越近笔触越长越粗 ----------
const SEA_FAR = ['#2f6f6c', '#3a857f', '#275c5d', '#4f9c90', '#346f70'];
const SEA_NEAR = ['#143a3f', '#1c4a4e', '#286261', '#102c2c', '#3a857f', '#1a4245'];
const sea: Stroke[][] = [[], [], [], []];
for (let i = 0; i < 340; i++) {
	const depth = Math.pow(R(), 1.25);
	const y = HZ + 8 + depth * (H - HZ + 20);
	const layer = Math.min(3, Math.floor(depth * 4));
	let c = pick(depth < 0.4 ? SEA_FAR : SEA_NEAR);
	let th = lerp(7, 36, depth) * r(0.7, 1.25);
	let o = r(0.72, 1);
	if (R() < 0.08) (c = pick(['#cfdccb', '#e9e2cf', '#a9cdbf'])), (th *= 0.32), (o = r(0.5, 0.85)); // 浪尖的白
	else if (depth < 0.45 && R() < 0.14) c = pick(['#d9a05b', '#c9824a']); // 映着天色
	sea[layer].push(stroke(r(-140, W + 140), y, lerp(70, 380, depth) * r(0.6, 1.3), th, r(-3, 3), c, o, 0.06));
}
// 日光在水面拉出的一道
const glint: Stroke[] = [];
for (let i = 0; i < 52; i++) {
	const depth = Math.pow(R(), 0.9);
	glint.push(
		stroke(SUN.x + (R() - 0.5) * 2 * lerp(36, 250, depth), HZ + 10 + depth * (H - HZ - 80), lerp(30, 170, depth) * r(0.6, 1.2), lerp(4, 15, depth), r(-2, 2),
			pick(['#f2c97c', '#eeb561', '#f6e2b0', '#d9853f', '#ffe9bd']), r(0.55, 0.92), 0.04),
	);
}

// ---------- 近岸：暗色的堤岸与芦苇 ----------
let bank = `M-40 ${H + 40}L-40 790`;
for (let x = 0; x <= W + 40; x += 70) {
	const t = x / W;
	bank += `L${x} ${(lerp(782, 868, Math.pow(t, 0.7)) + Math.sin(x / 130) * 9 + r(-8, 8)).toFixed(0)}`;
}
bank += `L${W + 40} ${H + 40}Z`;

type Reed = { d: string; c: string; w: number; tip?: { x: number; y: number; c: string } };
const reeds: Reed[] = [];
const clusters = [
	{ x0: -20, x1: 430, n: 44, hMin: 110, hMax: 330 },
	{ x0: 1150, x1: 1620, n: 46, hMin: 120, hMax: 360 },
	{ x0: 430, x1: 1150, n: 16, hMin: 50, hMax: 130 },
	{ x0: 720, x1: 980, n: 30, hMin: 130, hMax: 340 },
];
for (const cl of clusters) {
	for (let i = 0; i < cl.n; i++) {
		const x = r(cl.x0, cl.x1);
		const h = r(cl.hMin, cl.hMax);
		const lean = r(-0.16, 0.16) * h;
		const baseY = H + 20;
		const tipX = x + lean;
		const tipY = baseY - h;
		const reed: Reed = {
			d: `M${x.toFixed(0)} ${baseY}Q${(x + lean * 0.15).toFixed(0)} ${(baseY - h * 0.55).toFixed(0)} ${tipX.toFixed(0)} ${tipY.toFixed(0)}`,
			c: pick(['#232d1c', '#303b23', '#3f4b2b', '#1a2215', '#4e5a33', '#59633a']),
			w: Math.round(r(2.5, 6)),
		};
		if (R() < 0.34) reed.tip = { x: tipX, y: tipY, c: pick(['#a08a42', '#b99b4c', '#7d7038']) };
		reeds.push(reed);
	}
}

const paths = (list: Stroke[]) => list;
const VB = `0 0 ${W} ${H}`;
---

<div class="painting" aria-hidden="true">
	<svg class="lyr sky" viewBox={VB} preserveAspectRatio="xMidYMid slice">
		<defs>
			<!-- 鬃毛刷的毛边：用噪声把每一笔的边缘推歪一点 -->
			<filter id="pt-brush" x="-5%" y="-5%" width="110%" height="110%">
				<feTurbulence type="fractalNoise" baseFrequency="0.011 0.09" numOctaves="2" seed="4" result="n"></feTurbulence>
				<feDisplacementMap in="SourceGraphic" in2="n" scale="26" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
			</filter>
			<filter id="pt-brush-soft" x="-5%" y="-5%" width="110%" height="110%">
				<feTurbulence type="fractalNoise" baseFrequency="0.05 0.03" numOctaves="2" seed="9" result="n"></feTurbulence>
				<feDisplacementMap in="SourceGraphic" in2="n" scale="5" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
			</filter>
			<linearGradient id="pt-sky" x1="0" y1="0" x2="0" y2="1">
				<stop offset="0" stop-color="#132a2a"></stop>
				<stop offset=".3" stop-color="#2a5f5d"></stop>
				<stop offset=".5" stop-color="#d09a58"></stop>
				<stop offset=".53" stop-color="#2c6866"></stop>
				<stop offset="1" stop-color="#0f2a2c"></stop>
			</linearGradient>
		</defs>
		<rect x="-200" y="-100" width={W + 400} height={H + 200} fill="url(#pt-sky)"></rect>
		<g fill="none" stroke-linecap="round" filter="url(#pt-brush)">
			{paths(sky).map((s) => <path d={s.d} stroke={s.c} stroke-width={s.w} opacity={s.o} />)}
		</g>
		<g fill="none" filter="url(#pt-brush-soft)">
			{paths(shore).map((s) => <path d={s.d} stroke={s.c} stroke-width={s.w} opacity={s.o} stroke-linecap="butt" />)}
		</g>
	</svg>

	{
		sea.map((layer, i) => (
			<div class="par" data-parallax={0.03 + i * 0.035}>
				<svg class={`lyr sea s${i}`} viewBox={VB} preserveAspectRatio="xMidYMid slice">
					<g fill="none" stroke-linecap="round" filter="url(#pt-brush)">
						{layer.map((s) => <path d={s.d} stroke={s.c} stroke-width={s.w} opacity={s.o} />)}
						{i === 1 && glint.map((s) => <path d={s.d} stroke={s.c} stroke-width={s.w} opacity={s.o} />)}
					</g>
				</svg>
			</div>
		))
	}

	<div class="par" data-parallax="0.16">
		<svg class="lyr fore" viewBox={VB} preserveAspectRatio="xMidYMid slice">
			<path d={bank} fill="#0b100f"></path>

			<!-- 伊苏林迪竹节虫：站得很直，像一丛芦苇。只有你不动的时候，它才在。 -->
			<g transform="translate(-470 0)"><g class="phasmid" data-phasmid>
				<g fill="none" stroke="#dcebd3" stroke-linecap="round" stroke-linejoin="round">
					<path d="M1322 905C1324 800 1318 690 1312 600" stroke-width="6"></path>
					<path d="M1312 600C1310 580 1309 566 1310 556" stroke-width="4.5"></path>
					<path d="M1308 556C1298 500 1276 452 1250 420" stroke-width="1.6"></path>
					<path d="M1312 556C1318 498 1338 446 1362 412" stroke-width="1.6"></path>
					<path d="M1313 640L1262 598L1236 700L1228 905" stroke-width="2.6"></path>
					<path d="M1314 640L1370 592L1394 706L1400 905" stroke-width="2.6"></path>
					<path d="M1317 720L1272 690L1262 800L1258 905" stroke-width="2.4"></path>
					<path d="M1318 720L1362 686L1376 798L1378 905" stroke-width="2.4"></path>
					<path d="M1320 800L1288 786L1284 905" stroke-width="2.2"></path>
					<path d="M1321 800L1350 782L1356 905" stroke-width="2.2"></path>
				</g>
				<ellipse cx="1310" cy="552" rx="7" ry="10" fill="#dcebd3"></ellipse>
				<circle cx="1306.5" cy="549" r="1.6" fill="#0b100f"></circle>
				<circle cx="1313.5" cy="549" r="1.6" fill="#0b100f"></circle>
			</g></g>

			<g class="reeds" fill="none" stroke-linecap="round">
				{reeds.map((s) => <path d={s.d} stroke={s.c} stroke-width={s.w} />)}
				{reeds.filter((s) => s.tip).map((s) => <ellipse cx={s.tip!.x.toFixed(0)} cy={s.tip!.y.toFixed(0)} rx="4" ry="15" fill={s.tip!.c} stroke="none" />)}
			</g>
		</svg>
	</div>

	<div class="vignette"></div>
</div>

<style>
	.painting {
		position: absolute;
		inset: 0;
		overflow: hidden;
		background: #132a2a;
	}
	.par {
		position: absolute;
		inset: 0;
		transform: translate3d(0, var(--py, 0px), 0);
	}
	.lyr {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		overflow: visible;
	}

	/* 海面各层左右缓慢横移，像未干的颜料在流动 */
	.sea {
		animation: drift ease-in-out infinite alternate;
		will-change: transform;
	}
	.s0 {
		animation-duration: 19s;
		--dx: 14px;
	}
	.s1 {
		animation-duration: 15s;
		--dx: -22px;
	}
	.s2 {
		animation-duration: 12s;
		--dx: 30px;
	}
	.s3 {
		animation-duration: 9.5s;
		--dx: -40px;
	}
	@keyframes drift {
		from {
			transform: translate3d(calc(var(--dx) * -1), 0, 0);
		}
		to {
			transform: translate3d(var(--dx), 3px, 0);
		}
	}

	.reeds {
		transform-box: fill-box;
		transform-origin: 50% 100%;
		animation: sway 8s ease-in-out infinite alternate;
	}
	@keyframes sway {
		from {
			transform: skewX(-1.2deg);
		}
		to {
			transform: skewX(1.4deg);
		}
	}

	.phasmid {
		opacity: 0;
		transition: opacity 5s ease;
		filter: drop-shadow(0 0 10px rgba(220, 235, 211, 0.35));
		transform-box: fill-box;
		transform-origin: 50% 100%;
		animation: sway 6s ease-in-out infinite alternate;
	}
	.phasmid:global(.seen) {
		opacity: 0.92;
	}
	.phasmid:global(.gone) {
		transition-duration: 0.7s;
	}

	/* 暗角 + 底部融入页面底色 */
	.vignette {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, transparent 80%, var(--bg) 100%),
			radial-gradient(120% 90% at 40% 45%, transparent 60%, rgba(6, 10, 10, 0.45) 100%);
		pointer-events: none;
	}
</style>
