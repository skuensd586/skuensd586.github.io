---
// 原创的 SVG 黄色博美：蓬松的毛、竖立的小耳朵、黑亮的圆眼睛。
// 会眨眼、摇耳朵、吐舌头。动画类名（.eyes / .ear / .tongue）被 Pet.astro 复用，改名需同步。

/**
 * 生成一圈「毛边」轮廓：沿椭圆排布 n 撮毛，每撮是一段向外鼓出的二次曲线，
 * 尖端高度带确定性的伪随机起伏，所以看起来自然，且每次构建结果一致。
 */
function fur(cx: number, cy: number, rx: number, ry: number, n: number, amp: number, seed = 1) {
	const rnd = (i: number) => {
		const s = Math.sin(i * 127.1 + seed * 311.7) * 43758.5453;
		return s - Math.floor(s);
	};
	const at = (deg: number, k: number) => {
		const a = (deg * Math.PI) / 180;
		return `${(cx + rx * k * Math.cos(a)).toFixed(1)} ${(cy + ry * k * Math.sin(a)).toFixed(1)}`;
	};
	const step = 360 / n;
	let d = `M${at(0, 1)}`;
	for (let i = 0; i < n; i++) {
		const tip = 1 + amp * (0.55 + 0.9 * rnd(i)); // 控制点越远，毛尖越长
		d += `Q${at((i + 0.5) * step, tip)} ${at((i + 1) * step, 1)}`;
	}
	return d + 'Z';
}

const head = fur(120, 100, 63, 55, 30, 0.21, 3);
const body = fur(120, 194, 62, 38, 22, 0.12, 5);
const chest = fur(120, 178, 48, 28, 18, 0.2, 7);
---

<svg class="puppy" viewBox="0 0 240 230" role="img" aria-label="一只黄色的博美犬">
	<defs>
		<!-- 头毛：头顶金黄，向下渐变成奶油色 -->
		<linearGradient id="pup-fur" x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#e9a94c"></stop>
			<stop offset=".5" stop-color="#efb65e"></stop>
			<stop offset=".8" stop-color="#f5d197"></stop>
			<stop offset="1" stop-color="#f9e4bf"></stop>
		</linearGradient>
		<radialGradient id="pup-crown" cx="120" cy="64" r="46" gradientUnits="userSpaceOnUse">
			<stop offset="0" stop-color="#d98a38" stop-opacity=".55"></stop>
			<stop offset="1" stop-color="#d98a38" stop-opacity="0"></stop>
		</radialGradient>
		<radialGradient id="pup-cheek" cx="120" cy="124" r="52" gradientUnits="userSpaceOnUse">
			<stop offset="0" stop-color="#fdf3e0" stop-opacity=".95"></stop>
			<stop offset=".65" stop-color="#fbeacb" stop-opacity=".6"></stop>
			<stop offset="1" stop-color="#fbeacb" stop-opacity="0"></stop>
		</radialGradient>
		<radialGradient id="pup-shade" cx="96" cy="204" r="30" gradientUnits="userSpaceOnUse">
			<stop offset="0" stop-color="#b9ab97" stop-opacity=".55"></stop>
			<stop offset="1" stop-color="#b9ab97" stop-opacity="0"></stop>
		</radialGradient>
	</defs>

	<!-- 身体与胸毛 -->
	<path d={body} fill="#f1e1c8"></path>
	<ellipse cx="96" cy="204" rx="30" ry="20" fill="url(#pup-shade)"></ellipse>
	<path d={chest} fill="#f8ecd6"></path>

	<!-- 前爪 -->
	<g fill="#f8ecd6" stroke="#d9c6a6" stroke-width="2">
		<ellipse cx="94" cy="219" rx="19" ry="10"></ellipse>
		<ellipse cx="148" cy="219" rx="19" ry="10"></ellipse>
	</g>

	<!-- 耳朵：小而竖立，带一点前倾 -->
	<g class="ear ear-l">
		<path d="M56 70C53 52 59 37 72 40C84 43 92 55 95 68Z" fill="#d98d3a"></path>
		<path d="M65 64C64 53 68 46 73 48C79 50 83 56 85 63Z" fill="#f3c27d"></path>
	</g>
	<g class="ear ear-r">
		<path d="M184 70C187 52 181 37 168 40C156 43 148 55 145 68Z" fill="#d98d3a"></path>
		<path d="M175 64C176 53 172 46 167 48C161 50 157 56 155 63Z" fill="#f3c27d"></path>
	</g>

	<!-- 头：一整块带毛边的轮廓，再叠柔和的明暗 -->
	<path d={head} fill="url(#pup-fur)"></path>
	<ellipse cx="120" cy="64" rx="48" ry="26" fill="url(#pup-crown)"></ellipse>
	<ellipse cx="120" cy="124" rx="56" ry="46" fill="url(#pup-cheek)"></ellipse>

	<!-- 眼睛：黑亮、靠得近（眨眼动画作用于整个 g） -->
	<g class="eyes">
		<ellipse cx="95" cy="104" rx="6.4" ry="7.4" fill="#2a1d14"></ellipse>
		<ellipse cx="145" cy="104" rx="6.4" ry="7.4" fill="#2a1d14"></ellipse>
		<circle cx="97.4" cy="101" r="2.2" fill="#fff"></circle>
		<circle cx="147.4" cy="101" r="2.2" fill="#fff"></circle>
	</g>
	<!-- 眉点 -->
	<circle cx="93" cy="88" r="2.6" fill="#fbe9c4" opacity=".9"></circle>
	<circle cx="147" cy="88" r="2.6" fill="#fbe9c4" opacity=".9"></circle>

	<!-- 鼻子与嘴 -->
	<path d="M111 121C111 116 129 116 129 121C129 127 123.5 130 120 130C116.5 130 111 127 111 121Z" fill="#2a1d14"></path>
	<ellipse cx="116" cy="119.4" rx="3.6" ry="1.5" fill="#fff" opacity=".4"></ellipse>
	<path d="M120 130V135M120 135C115 141 108 139 107 134M120 135C125 141 132 139 133 134" fill="none" stroke="#2a1d14" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
	<!-- 舌头 -->
	<g class="tongue">
		<path d="M114 139C114 150 126 150 126 139Z" fill="#ff8aa0"></path>
		<path d="M120 139V146" stroke="#e45a76" stroke-width="1.8" stroke-linecap="round"></path>
	</g>
</svg>

<style>
	.puppy {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
		filter: drop-shadow(0 8px 14px rgba(40, 30, 10, 0.18));
	}

	/* 眨眼：每 5 秒一次 */
	.eyes {
		transform-box: fill-box;
		transform-origin: center;
		animation: blink 5s infinite;
	}
	@keyframes blink {
		0%,
		92%,
		100% {
			transform: scaleY(1);
		}
		95% {
			transform: scaleY(0.08);
		}
	}

	/* 耳朵以耳根为轴轻轻摆动 */
	.ear {
		transform-box: fill-box;
		transform-origin: 50% 92%;
	}
	.ear-l {
		animation: wiggle-l 4.2s ease-in-out infinite;
	}
	.ear-r {
		animation: wiggle-r 4.2s ease-in-out infinite 0.35s;
	}
	@keyframes wiggle-l {
		0%,
		100% {
			transform: rotate(0);
		}
		50% {
			transform: rotate(-7deg);
		}
	}
	@keyframes wiggle-r {
		0%,
		100% {
			transform: rotate(0);
		}
		50% {
			transform: rotate(7deg);
		}
	}

	/* 气喘吁吁的舌头 */
	.tongue {
		transform-box: fill-box;
		transform-origin: 50% 0;
		animation: pant 1.1s ease-in-out infinite;
	}
	@keyframes pant {
		0%,
		100% {
			transform: scaleY(1);
		}
		50% {
			transform: scaleY(1.2);
		}
	}
</style>
