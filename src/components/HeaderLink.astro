---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

// 去掉 base 前缀后，用首段路径判断是否为当前页
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname.slice(base.length).split('/').filter(Boolean)[0] ?? '';
const target = String(href).slice(base.length).split('/').filter(Boolean)[0] ?? '';
const isActive = current === target || (current === 'tags' && target === 'blog');
---

<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}>
	<slot />
</a>

<style>
	a {
		position: relative;
		display: inline-flex;
		align-items: center;
		padding: 4px 0;
		color: var(--ink-2);
		font-family: var(--font-display);
		font-size: 0.86rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		white-space: nowrap;
		transition: color 0.2s var(--ease);
	}
	a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -2px;
		height: 2px;
		background: var(--orange);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s var(--ease-out);
	}
	a:hover {
		color: var(--ink);
	}
	a.active {
		color: var(--ink);
	}
	a.active::after,
	a:hover::after {
		transform: scaleX(1);
	}
</style>
