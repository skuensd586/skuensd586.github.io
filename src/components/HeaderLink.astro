---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

// 去掉 base 前缀后，用首段路径判断是否为当前页
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname.slice(base.length).split('/').filter(Boolean)[0] ?? '';
const target = String(href).slice(base.length).split('/').filter(Boolean)[0] ?? '';
const isActive = current === target;
---

<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}>
	<slot />
</a>

<style>
	a {
		padding-bottom: 3px;
		border-bottom: 1px solid transparent;
		color: var(--text-2);
		font-family: var(--font-sans);
		font-size: 0.8rem;
		letter-spacing: 0.2em;
		transition:
			color 0.3s var(--ease),
			border-color 0.4s var(--ease);
	}
	a:hover {
		color: var(--text);
	}
	a.active {
		color: var(--text);
		border-bottom-color: var(--text-2);
	}
</style>
