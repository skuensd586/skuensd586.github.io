---
// 桌宠：站在页面右下角的像素小人。
// 点击：说一句话；连点：他会请你别戳了；久置：掏出笔记本记点什么。
import Kim from './Kim.astro';
---

<div class="pet" data-pet>
	<p class="bubble" data-bubble role="status" aria-live="polite" hidden></p>
	<div class="floats" data-floats aria-hidden="true"></div>
	<button class="body" type="button" data-pet-btn aria-label="和金说话">
		<span class="inner" data-inner><Kim /></span>
	</button>
</div>

<script>
	const root = document.querySelector<HTMLElement>('[data-pet]');
	if (root) {
		const btn = root.querySelector<HTMLButtonElement>('[data-pet-btn]')!;
		const inner = root.querySelector<HTMLElement>('[data-inner]')!;
		const bubble = root.querySelector<HTMLElement>('[data-bubble]')!;
		const floats = root.querySelector<HTMLElement>('[data-floats]')!;
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const lines = [
			'嗯。',
			'我在。继续吧。',
			'这一页你已经看了很久了。',
			'我记下来了。',
			'海风有点凉。不过无妨。',
			'不必着急，我们有的是时间。',
			'……好的。',
			'专注。先把眼前这一页看完。',
			'如果你在找搜索，它在右上角。',
		];
		const poked = ['请不要这样戳我。', '……警探。', '我建议你把手放回口袋里。'];
		const noting = ['（他翻开笔记本，记了点什么。）', '（他推了推眼镜，继续写。）'];
		const back = ['（他合上了笔记本。）什么事？', '嗯？我在听。'];

		let hideTimer: number | undefined;
		let idleTimer: number | undefined;
		let clicks: number[] = [];
		let last = -1;
		const pick = (arr: string[]) => arr[Math.floor(Math.random() * arr.length)];

		const say = (text: string, ms = 3200) => {
			bubble.innerHTML = '';
			const who = document.createElement('span');
			who.className = 'who';
			who.textContent = '金';
			bubble.append(who, ` — ${text}`);
			bubble.hidden = false;
			bubble.classList.remove('show');
			void bubble.offsetWidth; // 重新触发动画
			bubble.classList.add('show');
			window.clearTimeout(hideTimer);
			hideTimer = window.setTimeout(() => {
				bubble.classList.remove('show');
				window.setTimeout(() => (bubble.hidden = true), 300);
			}, ms);
		};

		const nod = () => {
			if (reduce) return;
			inner.classList.remove('nod');
			void inner.offsetWidth;
			inner.classList.add('nod');
		};

		const float = (text: string, cls: string) => {
			if (reduce) return;
			const s = document.createElement('span');
			s.className = cls;
			s.textContent = text;
			floats.append(s);
			window.setTimeout(() => s.remove(), 1700);
		};

		const resetIdle = () => {
			window.clearTimeout(idleTimer);
			idleTimer = window.setTimeout(() => {
				root.classList.add('noting');
				say(pick(noting), 3600);
			}, 40_000);
		};

		btn.addEventListener('click', () => {
			const now = Date.now();
			clicks = [...clicks.filter((t) => now - t < 3000), now];

			if (root.classList.contains('noting')) {
				root.classList.remove('noting');
				say(pick(back));
			} else if (clicks.length >= 5) {
				clicks = [];
				say(pick(poked));
				float('−1 士气', 'bad');
			} else {
				let i: number;
				do i = Math.floor(Math.random() * lines.length);
				while (i === last);
				last = i;
				say(lines[i]);
				if (Math.random() < 0.4) float('+1 士气', 'good');
			}
			nod();
			resetIdle();
		});

		resetIdle();
	}
</script>

<style>
	.pet {
		position: fixed;
		right: clamp(10px, 2.2vw, 26px);
		bottom: clamp(8px, 1.8vw, 20px);
		z-index: 90;
		width: clamp(48px, 5vw, 62px);
	}
	.body {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}
	.inner {
		display: block;
		transform-origin: 50% 100%;
		animation: idle 3.4s steps(2) infinite;
	}
	/* 像素风的呼吸：整像素地上下一格 */
	@keyframes idle {
		50% {
			transform: translateY(-2px);
		}
	}
	.inner:global(.nod) {
		animation: nod 0.5s steps(4);
	}
	@keyframes nod {
		0% {
			transform: translateY(0);
		}
		40% {
			transform: translateY(4px) scaleY(0.96);
		}
		100% {
			transform: translateY(0);
		}
	}
	.pet.noting :global(.notebook) {
		display: block;
	}

	/* 对话气泡：就是一行对话记录 */
	.bubble {
		position: absolute;
		right: 0;
		bottom: calc(100% + 12px);
		width: max-content;
		max-width: min(280px, 72vw);
		margin: 0;
		padding: 10px 14px 11px;
		background: var(--panel-2);
		border: 1px solid var(--line-2);
		border-left: 3px solid var(--orange);
		box-shadow: var(--shadow);
		color: var(--ink);
		font-size: 0.86rem;
		line-height: 1.7;
		opacity: 0;
		transform: translateY(6px);
		transition:
			opacity 0.25s var(--ease),
			transform 0.4s var(--ease-out);
	}
	.bubble.show {
		opacity: 1;
		transform: none;
	}
	.bubble :global(.who) {
		color: var(--ochre);
	}

	/* 飘字：士气加减 */
	.floats {
		position: absolute;
		left: 50%;
		top: -4px;
		pointer-events: none;
	}
	.floats :global(span) {
		position: absolute;
		left: 0;
		transform: translateX(-50%);
		white-space: nowrap;
		font-family: var(--font-display);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		animation: float-up 1.6s var(--ease-out) forwards;
	}
	.floats :global(.good) {
		color: var(--psy);
	}
	.floats :global(.bad) {
		color: var(--fys);
	}
	@keyframes float-up {
		from {
			opacity: 0;
			transform: translate(-50%, 0);
		}
		15% {
			opacity: 1;
		}
		to {
			opacity: 0;
			transform: translate(-50%, -46px);
		}
	}

	@media print {
		.pet {
			display: none;
		}
	}
</style>
