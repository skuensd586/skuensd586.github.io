---
import { NAV, SITE_TITLE, url } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="nav" data-nav>
	<nav class="container" aria-label="主导航">
		<a class="brand" href={url('')} aria-label={`${SITE_TITLE} 首页`}>
			<span class="zh">{SITE_TITLE}</span>
			<span class="en">Tide Journal</span>
		</a>
		<div class="links">
			{NAV.map((n) => <HeaderLink href={url(n.path)}>{n.name}</HeaderLink>)}
			<HeaderLink href={url('search/')} aria-label="搜索" class="search">
				<svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
					<circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
					<path d="M13 13l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
				</svg>
			</HeaderLink>
		</div>
	</nav>
</header>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		height: var(--nav-h);
		background: rgba(14, 20, 19, 0.82);
		-webkit-backdrop-filter: blur(14px);
		backdrop-filter: blur(14px);
		border-bottom: 1px solid var(--line);
	}
	nav {
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
	}
	.brand {
		display: inline-flex;
		align-items: baseline;
		gap: 12px;
		color: var(--ink);
		white-space: nowrap;
	}
	.zh {
		font-size: 1.25rem;
		font-weight: 900;
		letter-spacing: 0.3em;
	}
	.en {
		font-family: var(--font-display);
		font-size: 0.7rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--orange);
	}
	.brand:hover {
		color: var(--ink);
	}
	.links {
		display: flex;
		align-items: center;
		gap: clamp(14px, 2.6vw, 30px);
		overflow-x: auto;
		scrollbar-width: none;
	}
	.links::-webkit-scrollbar {
		display: none;
	}
	@media (max-width: 560px) {
		.en {
			display: none;
		}
	}
</style>
