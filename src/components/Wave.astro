---
// 一层无限循环流动的海浪：柔和的色块 + 一条细细的浪线。
// 路径由两个完全相同的周期拼成，横向平移 -50% 后正好首尾相接，所以循环无缝。
interface Props {
	/** 色块颜色（CSS 值） */
	color: string;
	/** 横向漂移一周所需秒数，越小越快 */
	duration?: number;
	/** 上下起伏一周所需秒数 */
	bob?: number;
	/** 反向漂移 */
	reverse?: boolean;
	/** 高度，例如 "180px" */
	height?: string;
	/** 起伏延迟，用于错开各层 */
	delay?: string;
	opacity?: number;
	/** 是否描一条浪线 */
	line?: boolean;
}

const {
	color,
	duration = 22,
	bob = 6,
	reverse = false,
	height = '180px',
	delay = '0s',
	opacity = 1,
	line = true,
} = Astro.props;

const crest = 'M0 100C360 40 720 160 1440 100C1800 40 2160 160 2880 100';
---

<div
	class="wave"
	aria-hidden="true"
	style={`--h:${height};--drift:${duration}s;--bob:${bob}s;--delay:${delay};--dir:${reverse ? 'reverse' : 'normal'};opacity:${opacity}`}
>
	<svg viewBox="0 0 2880 200" preserveAspectRatio="none" focusable="false">
		<path d={`${crest}V200H0Z`} fill={color}></path>
		{
			line && (
				<path
					d={crest}
					fill="none"
					stroke="var(--wave-line)"
					stroke-width="1.5"
					vector-effect="non-scaling-stroke"
				/>
			)
		}
	</svg>
</div>

<style>
	.wave {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: var(--h);
		overflow: hidden;
		animation: bob var(--bob) ease-in-out infinite var(--delay);
		pointer-events: none;
	}
	svg {
		display: block;
		width: 200%;
		max-width: none;
		height: 100%;
		animation: drift var(--drift) linear infinite;
		animation-direction: var(--dir);
	}
	@keyframes drift {
		to {
			transform: translateX(-50%);
		}
	}
	@keyframes bob {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(8px);
		}
	}
</style>
